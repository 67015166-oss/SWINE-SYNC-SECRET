# ────────────────────────────────────────────────────────────────
#  .env ของกล่อง  →  /home/dev/swine/app/.env
#  ★ คนละชุดกับ .env ของเครื่องผู้พัฒนา ค่าไม่เหมือนกัน ยกไปใช้ข้ามกันไม่ได้
#  ★★ ไม่มีค่าจริงในไฟล์นี้ — ค่าจริงอยู่ในก้อนที่เข้ารหัสเท่านั้น
# ────────────────────────────────────────────────────────────────

# ---------- ฐานข้อมูลหลัก (มีที่กล่องที่เดียว) ----------
DATABASE_URL=

# ---------- บัญชีผู้ดูแลระบบคนแรก ----------
# ★ ไม่มีสามค่านี้ = ขึ้นระบบใหม่แล้วไม่มีใครล็อกอินเข้าไปได้ และไม่มีอะไรฟ้อง
# ★ ย้ายเครื่องต้องตั้งรหัสใหม่ ห้ามยกรหัสเดิมมาใช้ซ้ำ
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=

# ---------- บทบาทของสะพาน ----------
# ★★ กล่องเป็น alerts · ห้ามรัน alerts หรือ full สองที่พร้อมกันบนฐานเดียวกัน
#    (จะเปิดใบแจ้งเตือนซ้ำ และคนที่ฟาร์มได้ข้อความไลน์สองชุด)
BRIDGE_ROLE=
BRIDGE_INTERVAL_SEC=
BRIDGE_BACKFILL_DAYS=

# ---------- ไลน์ OA ----------
# ★ LINE_DRY_RUN=1 คือลองโดยไม่ส่งจริง — ตั้งไว้ตอนทดสอบเสมอ โควตา 300 ข้อความ/เดือน
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_TARGET=
LINE_NOTIFY=
LINE_DRY_RUN=
LINE_DAILY_AT=
LINE_MAX_PER_DAY=
LINE_ALERT_LEVELS=
LINE_ALERT_COOLDOWN_HOURS=
LINE_ALERT_MAX_AGE_MIN=

# ---------- ตู้กลางที่รับข้อมูลจากทีมอื่น ----------
# ★★ HUB_KEY_SECRET หายแล้วกู้คืนไม่ได้ · เปลี่ยนค่าต้องถอดด้วยตัวเก่าแล้ว
#    เข้ารหัสใหม่ในคราวเดียว — แก้ไฟล์เฉย ๆ แล้วรีสตาร์ต = ทำของหาย
HUB_KEY_SECRET=

# ---------- AI ของฟาร์ม (ทีมอื่น) ----------
# ⚠ ใช้ได้เฉพาะฝั่งเซิร์ฟเวอร์ ห้ามเอาไปไว้ในโค้ดหน้าเว็บ
CPF_AI_URL=
CPF_AI_API_KEY=
CPF_AI_USER_ID=
CPF_AI_USER_MAP=
CPF_AI_LEVEL=

# ---------- ระบบวอยซ์ Farmy (ทีมอื่น) ----------
# ⚠ บัญชีนี้ใช้ร่วมกันทุกคนที่ถามผ่านแดชบอร์ด ฝั่งเขาแยกไม่ออกว่าใครถาม
FARMY_URL=
FARMY_USERNAME=
FARMY_PASSWORD=

# ---------- กุญแจอ่านค่าจากต้นทางของท่อรับค่าเซนเซอร์ ----------
INFLUX_URL=
INFLUX_ORG=
INFLUX_BUCKET=
INFLUX_MEASUREMENT=
INFLUX_TOKEN=

# ---------- เฝ้าระวัง ----------
PRIMARY_HEALTH_URL=
PRIMARY_NAME=
PRIMARY_OWNER=
PRIMARY_CHECK_MIN=
PRIMARY_WATCH_NOTIFY=

# ---------- อื่น ๆ ----------
API_PORT=
CORS_ORIGINS=
DASHBOARD_URL=
NODE_ENV=
LOG_LEVEL=
TZ=
