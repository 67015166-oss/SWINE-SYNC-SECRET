# ────────────────────────────────────────────────────────────────
#  weather/.env — คลังข้อมูลสำหรับเทรนโมเดลพยากรณ์
#  ★ คนละระบบกับแดชบอร์ด คนละฐาน คนละ compose — พังแล้วแดชบอร์ดไม่กระทบ
#  ★★ ไม่มีค่าจริงในไฟล์นี้
# ────────────────────────────────────────────────────────────────

# ---------- ฐานของคลังนี้ ----------
WX_DB_NAME=
WX_DB_USER=
WX_DB_PASSWORD=
WX_DB_PORT=
WX_LAB_PORT=

# ---------- ที่มาของข้อมูล ----------
# ★ กุญแจ PlotNexus ถูกถอนสิทธิ์ตั้งแต่ 11 ก.ย. 2569 — ตัวที่มีใช้ไม่ได้แล้ว
#   ขอใบใหม่เสมอ ห้ามใช้ตัวเดิม (ตัวเดิมเคยถูก build ลงไฟล์ที่เปิดดูได้ ถือว่าหลุดแล้ว)
PLOTNEXUS_ENABLED=
PLOTNEXUS_KEY=
PLOTNEXUS_SOURCE=
PLOTNEXUS_EVERY_SEC=

# ค่าเซนเซอร์จากฐานของแดชบอร์ด
SWINE_DB_URL=
SWINE_EVERY_SEC=

# อากาศภายนอกจาก Open-Meteo (ฟรี ไม่ต้องมีกุญแจ)
# ★ เป็นค่า "ทำนาย" จากแบบจำลอง ห้ามเอาไปปนกับค่าที่เสาอากาศวัดได้
OPEN_METEO_EVERY_SEC=
FARM_LAT=
FARM_LON=
